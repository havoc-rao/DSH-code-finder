{
  "name": "@omdsh-dev/dsh-code-finder",
  "version": "0.1.0",
  "description": "Dev-only React component → source code locator: hold Opt+Shift to see which component rendered an element and jump to its source. Plug into any React app (vite/tsdown) or DSH plugin (cordis).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/omdsh-dev/DSH-code-finder"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis": {
      "types": "./lib/types/cordis/host.d.ts",
      "default": "./lib/cordis.js"
    },
    "./cordis/client": {
      "types": "./lib/types/cordis/client.d.ts",
      "default": "./lib/cordis-client.js"
    },
    "./tsdown": {
      "types": "./lib/types/build/tsdown.d.ts",
      "default": "./lib/tsdown.js"
    },
    "./vite": {
      "types": "./lib/types/build/vite.d.ts",
      "default": "./lib/vite.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/cordis.js",
    "lib/cordis-client.js",
    "lib/tsdown.js",
    "lib/vite.js",
    "lib/types/**/*.d.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "watch": "tsdown --watch"
  },
  "keywords": [
    "react",
    "debug",
    "locator",
    "inspector",
    "sourcemap",
    "dsh"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@locator/babel-jsx": "^0.5.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "cordis": "^4.0.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.0.0",
    "jsdom": "^29.1.1",
    "rolldown": "^1.2.4",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.8"
  }
}
